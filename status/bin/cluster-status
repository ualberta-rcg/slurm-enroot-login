#!/usr/bin/env bash
# cluster-status — pod-aware HPC login status banner for Slurm clusters.
# Generalized from vulcan-status for slurm-login-pods.
#
# Safe on the login path: every external call is timeout-bounded, missing data
# hides its block, Slurm-derived strings are sanitized against terminal escape
# injection, and the script always exits 0.
#
# Inside login pods, container-sshd-entrypoint maintains a jittered snapshot in
# /tmp/cluster-status (CLUSTER_STATUS_CACHE_DIR). On gateway hosts, the systemd
# timer cluster-status-bake.timer refreshes /run/cluster-status every 10 min.
#
# Flags: --plain  --no-cache  --only BLOCK  --user NAME (root)  --width N
# Blocks: header notice pod cluster jobs fairshare storage links

set -u
PATH=/usr/local/bin:/usr/bin:/bin

PROG_NAME=$(basename "$0" 2>/dev/null || echo cluster-status)

CONF="${CLUSTER_STATUS_CONF:-/etc/cluster-status/motd.conf}"
[ -r "$CONF" ] && . "$CONF"
if [ "$PROG_NAME" = "cluster-status" ] && [ -n "${STATUS_CMD_NAME:-}" ]; then
    PROG_NAME="$STATUS_CMD_NAME"
fi

# ---- defaults (override in /etc/cluster-status/motd.conf) -----------------
ANNOUNCE=${ANNOUNCE:-/etc/cluster-status/announce.txt}
LOGO_FILE=${LOGO_FILE:-/etc/cluster-status/logo.txt}
LINKS_FILE=${LINKS_FILE:-/etc/cluster-status/links.txt}
SITE_TITLE=${SITE_TITLE-Digital Research Alliance of Canada}
SITE_SUBTITLE=${SITE_SUBTITLE-}
MAX_JOBS=${MAX_JOBS:-3}
MAX_PROJECTS=${MAX_PROJECTS:-3}
WIDE_MIN=${WIDE_MIN:-70}
CLUSTER_NAME=${CLUSTER_NAME:-${CC_CLUSTER:-$(hostname -s 2>/dev/null || echo cluster)}}
LOGIN_PARTITION=${LOGIN_PARTITION:-login}
HOME_BASE=${HOME_BASE:-/home}
SCRATCH_BASE=${SCRATCH_BASE:-/scratch}
FS_BOOST=${FS_BOOST:-0.80}
FS_AHEAD=${FS_AHEAD:-0.60}
FS_NOMINAL=${FS_NOMINAL:-0.40}
FS_BEHIND=${FS_BEHIND:-0.20}
DISK_MID=${DISK_MID:-33}
DISK_HIGH=${DISK_HIGH:-66}
LFS_LOW=${LFS_LOW:-0.75}
LFS_HIGH=${LFS_HIGH:-1.25}
Q_TIMEOUT=${Q_TIMEOUT:-3}

# ---- caching --------------------------------------------------------------
CACHE_DIR=${CLUSTER_STATUS_CACHE_DIR:-${CACHE_DIR:-/run/cluster-status}}
CLUSTER_CACHE=${CLUSTER_CACHE:-$CACHE_DIR/cluster}
HEARTBEAT=${HEARTBEAT:-$CACHE_DIR/heartbeat}
CLUSTER_TTL=${CLUSTER_TTL:-900}
USER_CACHE_DIR=${USER_CACHE_DIR:-${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/cluster-status}}
FAIRSHARE_TTL=${FAIRSHARE_TTL:-900}
STORAGE_TTL=${STORAGE_TTL:-900}

# ---- args -----------------------------------------------------------------
PLAIN=0 NO_CACHE=0 ONLY="" WIDTH=0
TUSER=${USER:-$(id -un 2>/dev/null)}
while [ $# -gt 0 ]; do
    case "$1" in
        --plain)    PLAIN=1 ;;
        --no-cache) NO_CACHE=1 ;;
        --only)     ONLY=${2:-}; shift ;;
        --user)     TUSER=${2:-}; shift ;;
        --width)    WIDTH=${2:-0}; shift ;;
        -h|--help)  WANT_HELP=1 ;;
        *) printf '%s: unknown flag %s\n' "$PROG_NAME" "$1" >&2; exit 2 ;;
    esac
    shift
done
if [ "$TUSER" != "${USER:-}" ] && [ "$(id -u)" != "0" ]; then
    printf '%s: --user requires root\n' "$PROG_NAME" >&2; exit 2
fi

# ---- color ----------------------------------------------------------------
USE_COLOR=1
if [ "$PLAIN" = 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
    USE_COLOR=0
fi
c() { [ "$USE_COLOR" = 1 ] && printf '\033[%sm' "$1"; return 0; }

if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *[Uu][Tt][Ff]* ]]; then
    BAR_FULL='▓'; BAR_EMPTY='░'
    INF_SYM=$(printf '\xe2\x88\x9e')
else
    BAR_FULL='#'; BAR_EMPTY='-'
    INF_SYM='inf'
fi
HINT_ARROW='->'

# ---- width ----------------------------------------------------------------
if [ "$WIDTH" -le 0 ]; then
    case "${COLUMNS:-}" in ''|*[!0-9]*|0) WIDTH=$(tput cols 2>/dev/null || echo 80) ;; *) WIDTH=$COLUMNS ;; esac
    case "$WIDTH" in ''|*[!0-9]*) WIDTH=80 ;; esac
fi
if [ "$WIDTH" -ge "$WIDE_MIN" ]; then
    LAYOUT=wide; BARW=20; BARW_SMALL=14; NAMEW=16
else
    LAYOUT=compact; BARW=10; BARW_SMALL=10; NAMEW=12
fi

# ---- helpers --------------------------------------------------------------
mkbar() {
    local pct=$1 w=$2 col=$3 filled fill empt
    filled=$(( pct * w / 100 )); [ "$filled" -gt "$w" ] && filled=$w
    printf -v fill '%*s' "$filled" '';          fill=${fill// /$BAR_FULL}
    printf -v empt '%*s' $(( w - filled )) '';  empt=${empt// /$BAR_EMPTY}
    c "$col"; printf '%s' "$fill"
    c '2';    printf '%s' "$empt"
    c '0'
}

bar() {
    local col='38;5;79'
    [ "$1" -ge 80 ] && col='38;5;214'; [ "$1" -ge 95 ] && col='1;38;5;203'
    mkbar "$1" "$2" "$col"
}

dbar() {
    local col='38;5;79'
    [ "$1" -ge "$DISK_MID" ] && col='38;5;75'; [ "$1" -ge "$DISK_HIGH" ] && col='1;38;5;203'
    mkbar "$1" "$2" "$col"
}

hdr() {
    printf '\n'
    c '1'; printf '» %s' "$1"; c '0'
    [ -n "${2:-}" ] && printf '   %s' "$2"
    printf '\n'
}

hint() {
    c '38;5;252'; printf '  %s Want more detail? Run: %s\n' "$HINT_ARROW" "$1"; c '0'
}

sanitize() { printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'; }

explain_cluster() {
    printf '\n'
    c '1'
    printf '    Cluster — compute capacity across %s, refreshed every 10 minutes\n' "$CLUSTER_NAME"
    c '0'
    printf '      Nodes   compute machines scheduling batch jobs; "(N down)" ones\n'
    printf '              are offline or drained for maintenance\n'
    printf '      Queue   batch jobs across the cluster — running now vs pending\n'
    printf '              (persistent login pods are excluded from batch counts)\n'
    printf '      CPUs    processor cores allocated vs total across compute nodes\n'
    printf '      Mem     memory (RAM) reserved by running compute jobs vs total\n'
    printf '      GPUs    "avail" is unallocated GPUs; "usable" estimates how many\n'
    printf '              also have proportional CPU and RAM free on their host node\n'
}

explain_jobs() {
    printf '\n'
    c '1'
    printf '    Your jobs — your own compute jobs, live from Slurm\n'
    c '0'
    printf '      up       how long the job has been running\n'
    printf '      left     time remaining before the walltime limit\n'
    printf '      gres/…   accelerators reserved by the job\n'
    printf '      held     pending reason (Priority, Resources, Dependency)\n'
}

explain_fairshare() {
    printf '\n'
    c '1'
    printf '    Fairshare — scheduling priority relative to other allocations\n'
    c '0'
    printf '      factor    0 to 1 (1 = highest priority headroom, 0 = heavy recent usage)\n'
    printf '      LevelFS   account share-to-usage ratio (high/inf = under share)\n'
}

explain_storage() {
    printf '\n'
    c '1'
    printf '    Storage — filesystem usage across home, scratch, and project spaces\n'
    c '0'
    printf '      Bar colour: comfortable under %d%% · filling under %d%% · high at %d%%+\n' "$DISK_MID" "$DISK_HIGH" "$DISK_HIGH"
}

thou() { printf "%'d" "$1" 2>/dev/null || printf '%d' "$1"; }

CTLD=1; DBD=1
if [ -r "$HEARTBEAT" ]; then
    while IFS= read -r kv; do
        case "$kv" in
            ctld=0) CTLD=0 ;;
            dbd=0)  DBD=0  ;;
        esac
    done < "$HEARTBEAT"
fi

cache_fresh() { [ -r "$1" ] && [ -z "$(find "$1" -mmin +"$(( ($2+59)/60 ))" 2>/dev/null)" ]; }

# Detect rootless user-namespace overflow UID (65534 = unmapped host root on /tmp)
UNMAPPED_ROOT_OK=0
if [ -r /proc/self/uid_map ] && ! awk '$1 == 0 {found=1} END {exit !found}' /proc/self/uid_map 2>/dev/null; then
    UNMAPPED_ROOT_OK=1
fi

private_cache_file() {
    local dir=$USER_CACHE_DIR parent part path='' meta owner='' mode=0
    local -a parts
    [[ $EUID != 0 && $NO_CACHE = 0 && $dir = /*/* && $dir != *//* && $dir != */ && $dir != *$'\n'* ]] || return 1
    parent=${dir%/*}
    IFS=/ read -r -a parts <<< "${parent#/}"
    for part in "${parts[@]}"; do
        [[ -n $part && $part != . && $part != .. ]] || return 1
        path+=/$part
        [[ ! -L $path && -d $path ]] || return 1
        meta=$(stat -c '%u:%a' -- "$path") || return 1
        owner=${meta%:*}; mode=${meta#*:}
        local is_root_anc=0
        if (( owner == 0 )) || { (( UNMAPPED_ROOT_OK == 1 && owner == 65534 )); }; then
            is_root_anc=1
        fi
        (( owner == EUID || is_root_anc == 1 )) || return 1
        (( !(8#$mode & 022) || (is_root_anc == 1 && (8#$mode & 01000)) )) || return 1
    done
    [[ $owner = "$EUID" && $mode = 700 && ${dir##*/} != . && ${dir##*/} != .. ]] || return 1
    mkdir -m 700 -- "$dir" 2>/dev/null || [[ -d $dir ]] || return 1
    [[ ! -L $dir && $(stat -c '%u:%a' -- "$dir") = "$EUID:700" ]] || return 1
    [[ ! -L $dir/$1 && ( ! -e $dir/$1 || -f $dir/$1 ) ]] || return 1
    printf '%s/%s\n' "$dir" "$1"
}

write_private_cache() {
    local file=$1 tmp
    tmp=$(mktemp -- "$file.XXXXXXXX") || return 1
    printf '%s\n' "$2" > "$tmp" && mv -fT -- "$tmp" "$file" && return 0
    rm -f -- "$tmp"
    return 1
}

cluster_from_cache() {
    [ "$NO_CACHE" = 0 ] || return 1
    cache_fresh "$CLUSTER_CACHE" "$CLUSTER_TTL" || return 1
    local k v n=0
    while IFS='=' read -r k v; do
        case "$k" in
            nodes_up|nodes_down|cpu_alloc|cpu_total|mem_alloc_mb|mem_total_mb|gpu_alloc|gpu_total|queue_r|queue_pd|gpu_usable)
                case "$v" in *[!0-9]*|'') continue ;; esac
                printf -v "$k" '%s' "$v"; n=$((n+1)) ;;
        esac
    done < "$CLUSTER_CACHE"
    [ "$n" -ge 6 ]
}

# ============================================================================
# Blocks
# ============================================================================

render_header() {
    local L pod_host
    pod_host=$(hostname -s 2>/dev/null || echo "$CLUSTER_NAME")
    c '1;36'
    if [ -s "$LOGO_FILE" ] && [ -r "$LOGO_FILE" ]; then
        while IFS= read -r L; do printf '%s\n' "$L"; done < "$LOGO_FILE"
    else
        while IFS= read -r L; do printf '%s\n' "$L"; done <<'LOGO'
      _           _
  ___| |_   _ ___| |_ ___ _ __
 / __| | | | / __| __/ _ \ '__|
| (__| | |_| \__ \ ||  __/ |
 \___|_|\__,_|___/\__\___|_|
LOGO
    fi
    c '0'
    printf '\n'
    [ -n "$SITE_TITLE" ]    && { c '1;37'; printf '%s\n' "$SITE_TITLE";    c '0'; }
    [ -n "$SITE_SUBTITLE" ] && { c '2;37'; printf '%s\n' "$SITE_SUBTITLE"; c '0'; }
    if [ -n "${LOGIN_JOB_ID:-}" ]; then
        c '38;5;252'
        printf 'pod %s · cluster %s · user %s · %s\n' "$pod_host" "$CLUSTER_NAME" "$TUSER" "$(date '+%Y-%m-%d %H:%M %Z')"
        c '0'
    elif [ "$LAYOUT" = wide ]; then
        c '38;5;252'; printf 'node %s · user %s · %s\n' "$pod_host" "$TUSER" "$(date '+%Y-%m-%d %H:%M %Z')"; c '0'
    else
        c '38;5;252'; printf '%s · %s · %s\n' "$pod_host" "$TUSER" "$(date '+%Y-%m-%d %H:%M %Z')"; c '0'
    fi
}

render_notice() {
    [ -s "$ANNOUNCE" ] || return 0
    hdr 'Notice'
    c '33'
    sed 's/^/  /' "$ANNOUNCE"
    c '0'
}

render_pod() {
    local jid="${LOGIN_JOB_ID:-}"
    if [ -z "$jid" ] && command -v squeue >/dev/null 2>&1; then
        jid=$(timeout "$Q_TIMEOUT" squeue -h -u "$TUSER" -p "$LOGIN_PARTITION" -n "login-${TUSER}" -t R -o '%i' 2>/dev/null | head -n 1 || true)
    fi
    [ -n "$jid" ] || return 0
    command -v squeue >/dev/null 2>&1 || return 0
    local info
    info=$(timeout "$Q_TIMEOUT" squeue -h -j "$jid" -o '%i|%j|%N|%C|%m|%M|%L' 2>/dev/null | head -n 1 || true)
    [ -n "$info" ] || return 0
    local p_id p_name p_node p_cpus p_mem p_up p_left
    IFS='|' read -r p_id p_name p_node p_cpus p_mem p_up p_left <<< "$info"
    p_name=$(sanitize "$p_name"); p_node=$(sanitize "${LOGIN_POD_NODE:-$p_node}")
    hdr 'Login pod'
    printf '  '
    c '38;5;79'; printf '%s' "$p_name"; c '0'
    printf ' (job %s on %s) · %s CPU / %s RAM · up %s · left %s\n' "$p_id" "$p_node" "$p_cpus" "$p_mem" "$p_up" "$p_left"
    hint 'login-pod status · login-pod restart'
}

cluster_compute_live() {
    command -v scontrol >/dev/null 2>&1 || return 1
    local s
    s=$(timeout "$((Q_TIMEOUT*2))" scontrol -o show nodes 2>/dev/null) || return 1
    [ -n "$s" ] || return 1
    eval "$(printf '%s\n' "$s" | awk -v lp="$LOGIN_PARTITION" '
        function has_compute_part(parts,   n, a, i) {
            if (parts == "") return 0
            n = split(parts, a, ",")
            for (i = 1; i <= n; i++) if (a[i] != "" && a[i] != lp) return 1
            return 0
        }
        {
            lines[++nr] = $0
            for (i = 1; i <= NF; i++) if ($i ~ /^Partitions=/) { split($i, p, "="); if (has_compute_part(p[2])) any_part = 1 }
        }
        END {
            for (r = 1; r <= nr; r++) {
                $0 = lines[r]
                parts = ""; st = ""; nrm=nam=cc=ac=cg=ag=0
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^Partitions=/) { split($i,a,"="); parts=a[2] }
                    if ($i ~ /^State=/)      { split($i,a,"="); st=tolower(a[2]) }
                    if ($i ~ /^RealMemory=/) { split($i,a,"="); nrm=a[2]+0 }
                    if ($i ~ /^AllocMem=/)   { split($i,a,"="); nam=a[2]+0 }
                    if ($i ~ /^CfgTRES=/)    {
                        if (match($i, /gres\/gpu=[0-9]+/)) { g=substr($i,RSTART+9,RLENGTH-9)+0; cg=g }
                        if (match($i, /cpu=[0-9]+/))       cc=substr($i,RSTART+4,RLENGTH-4)+0
                    }
                    if ($i ~ /^AllocTRES=/)  {
                        if (match($i, /gres\/gpu=[0-9]+/)) { g=substr($i,RSTART+9,RLENGTH-9)+0; ag=g }
                        if (match($i, /cpu=[0-9]+/))       ac=substr($i,RSTART+4,RLENGTH-4)+0
                    }
                }
                if (any_part && !has_compute_part(parts)) continue
                if (st ~ /(down|drain|drng|unk|fail|maint)/) d++; else u++
                tc += cc; tac += ac; trm += nrm; tam += nam; gt += cg; ga += ag
                if (cg > 0 && st !~ /(down|drain|drng|unk|fail|maint)/) {
                    cpu_per = cc/cg; mem_per = (nrm>0 ? nrm/cg : 0)
                    ug = cg - ag
                    v = (cpu_per>0 ? int((cc-ac)/cpu_per) : 0)
                    w = (mem_per>0 ? int((nrm-nam)/mem_per) : 0)
                    if (v < ug) ug=v; if (w < ug) ug=w
                    if (ug > 0) usable += ug
                }
            }
            printf "nodes_up=%d nodes_down=%d cpu_alloc=%d cpu_total=%d mem_alloc_mb=%d mem_total_mb=%d gpu_alloc=%d gpu_total=%d gpu_usable=%d\n",
                   u+0, d+0, tac+0, tc+0, tam+0, trm+0, ga+0, gt+0, usable+0
        }')"
    local qraw
    qraw=$(timeout "$Q_TIMEOUT" squeue -h -t R,PD -o '%t|%P|%j' 2>/dev/null || true)
    eval "$(printf '%s\n' "$qraw" | awk -F'|' -v lp="$LOGIN_PARTITION" '
        NF >= 3 && $2 != lp && $3 !~ /^(login|robot|admin)-/ {
            if ($1 == "R") r++; else if ($1 == "PD") pd++
        }
        END { printf "queue_r=%d queue_pd=%d\n", r+0, pd+0 }')"
    return 0
}

gpu_line() {
    [ "${gpu_total:-0}" -gt 0 ] || return 0
    local gpct usable
    gpct=$(( gpu_alloc * 100 / gpu_total ))
    usable=$(( gpu_total - gpu_alloc ))
    [ "${gpu_usable:--1}" -ge 0 ] && usable=$gpu_usable
    printf '  GPUs:  '; bar "$gpct" "$1"
    printf ' %d%% (%s/%s · ' "$gpct" "$(thou "$gpu_alloc")" "$(thou "$gpu_total")"
    c '38;5;79'; printf '%s avail · ' "$(thou $(( gpu_total - gpu_alloc )))"; c '0'
    if [ "$usable" -gt 0 ]; then
        c '38;5;79'; printf '%s usable' "$(thou "$usable")"; c '0'
    else
        c '1;38;5;214'; printf '%s usable' "$(thou "$usable")"; c '0'
    fi
    printf ')\n'
}

render_cluster() {
    if ! cluster_from_cache; then
        [ "$CTLD" = 0 ] && return 0
        cluster_compute_live || return 0
    fi
    local total=$(( ${nodes_up:-0} + ${nodes_down:-0} ))
    [ "$total" -eq 0 ] && return 0
    hdr 'Cluster'
    local cpupct mempct
    cpupct=0; [ "${cpu_total:-0}" -gt 0 ] && cpupct=$(( cpu_alloc * 100 / cpu_total ))
    mempct=0; [ "${mem_total_mb:-0}" -gt 0 ] && mempct=$(( mem_alloc_mb * 100 / mem_total_mb ))
    if [ "$LAYOUT" = wide ]; then
        printf '  Nodes: '
        c '38;5;79'; printf '%s/%s up' "$nodes_up" "$total"; c '0'
        if [ "$nodes_down" -gt 0 ]; then c '38;5;214'; printf ' (%s down)' "$nodes_down"; c '0'; fi
        printf ' · Queue: '
        c '1';  printf '%s' "$(( queue_r + queue_pd ))"; c '0'
        printf ' ('
        c '38;5;79'; printf '%s running' "$queue_r"; c '0'
        printf ', '
        c '38;5;214'; printf '%s pending' "$queue_pd"; c '0'
        printf ')\n'
        printf '  CPUs:  '; bar "$cpupct" "$BARW"
        printf ' %s%% (%s/%s) · Mem: ' "$cpupct" "$(thou "$cpu_alloc")" "$(thou "$cpu_total")"
        bar "$mempct" "$BARW_SMALL"
        printf ' %s%%\n' "$mempct"
        gpu_line "$BARW"
    else
        printf '  Nodes: '
        c '38;5;79'; printf '%s/%s up' "$nodes_up" "$total"; c '0'
        if [ "$nodes_down" -gt 0 ]; then c '38;5;214'; printf ' (%s down)' "$nodes_down"; c '0'; fi
        printf '\n  Queue: '
        c '1'; printf '%s' "$(( queue_r + queue_pd ))"; c '0'
        printf ' ('
        c '38;5;79'; printf '%s run' "$queue_r"; c '0'
        printf ' / '
        c '38;5;214'; printf '%s pend' "$queue_pd"; c '0'
        printf ')\n'
        printf '  CPUs: '; bar "$cpupct" "$BARW"
        printf ' %s%%  Mem: ' "$cpupct"
        bar "$mempct" "$BARW"
        printf ' %s%%\n' "$mempct"
        gpu_line "$BARW"
    fi
    hint 'sinfo · sq'
}

render_jobs() {
    command -v squeue >/dev/null 2>&1 || return 0
    local raw out
    raw=$(timeout "$Q_TIMEOUT" squeue -u "$TUSER" -h -o '%A|%P|%j|%T|%M|%L|%R|%b' 2>/dev/null) || return 0
    out=$(printf '%s\n' "$raw" | awk -F'|' -v lp="$LOGIN_PARTITION" 'NF >= 4 && $2 != lp && $3 !~ /^(login|robot|admin)-/ { print }')
    local nr np
    nr=$(printf '%s\n' "$out" | grep -c '|RUNNING|' || true)
    np=$(printf '%s\n' "$out" | grep -c '|PENDING|' || true)
    if [ -z "$out" ]; then
        hdr 'Your jobs'
        c '38;5;252'; printf '  no active compute jobs\n'; c '0'
        hint 'sq'
        return 0
    fi
    hdr 'Your jobs' "$(c '38;5;79')$nr running$(c '0') · $(c '38;5;214')$np pending$(c '0')"
    printf '%s\n' "$out" | head -n "$MAX_JOBS" | while IFS='|' read -r jid part name st tum tleft reason tres; do
        jid=$(sanitize "$jid"); part=$(sanitize "$part"); name=$(sanitize "$name")
        tum=$(sanitize "$tum"); tleft=$(sanitize "$tleft"); tres=$(sanitize "$tres")
        reason=$(sanitize "$reason")
        part=${part%%,*}; part=${part:0:16}
        name=${name:0:$NAMEW}
        if [ "$st" = RUNNING ]; then
            case "$tleft" in N/A|UNLIMITED|'') tleft='-' ;; esac
            case "$tres" in N/A|'') tres='' ;; esac
            if [ "$LAYOUT" = wide ]; then
                printf '  '
                c '1'; printf '%s' "$jid"; c '0'
                printf '  %-8s  %-16s  up %-8s  left %-8s  %s\n' "$part" "$name" "$tum" "$tleft" "$tres"
            else
                printf '  '
                c '1'; printf '%s' "$jid"; c '0'
                printf ' %s %s\n    up %s  left %s  %s\n' "$part" "$name" "$tum" "$tleft" "$tres"
            fi
        else
            reason=${reason#(}; reason=${reason%)}
            case "$reason" in
                Priority*)        reason=Priority ;;
                Resources*)       reason=Resources ;;
                Dependency*)      reason=Dependency ;;
                ReqNodeNotAvail*) reason='nodes unavailable' ;;
                *DOWN,\ DRAINED*) reason='nodes down/drained' ;;
                *) reason=$(printf '%s' "$reason" | cut -c1-28) ;;
            esac
            if [ "$LAYOUT" = wide ]; then
                c '38;5;252'; printf '  %-8s  %-8s  %-16s  held: %s\n' "$jid" "$part" "$name" "$reason"; c '0'
            else
                c '38;5;252'; printf '  %s %s %-12s held: %s\n' "$jid" "$part" "$name" "$reason"; c '0'
            fi
        fi
    done
    local total
    total=$(printf '%s\n' "$out" | grep -c .)
    if [ "$total" -gt "$MAX_JOBS" ]; then
        c '38;5;252'; printf '  … and %d more\n' "$(( total - MAX_JOBS ))"; c '0'
    fi
    hint 'sq'
}

fs_eval() {
    awk -v f="$1" -v b="$FS_BOOST" -v a="$FS_AHEAD" -v n="$FS_NOMINAL" -v e="$FS_BEHIND" 'BEGIN{
        ff=f+0; pct=(ff<0?0:(ff>1?1:ff))*100
        if      (ff >= b+0) l="boosted"
        else if (ff >= a+0) l="ahead"
        else if (ff >= n+0) l="nominal"
        else if (ff >= e+0) l="behind"
        else                l="throttled"
        printf "%d|%s", pct, l }'
}

lfs_txt() {
    case "$1" in
        inf) printf '%s' "$INF_SYM" ;;
        '')  printf '' ;;
        *)   awk -v v="$1" 'BEGIN{ printf "%.2f", v+0 }' ;;
    esac
}
lfs_lab() {
    awk -v v="$1" -v lo="$LFS_LOW" -v hi="$LFS_HIGH" 'BEGIN{
        if (v == "inf" || v+0 > hi+0)  print "good"
        else if (v+0 < lo+0)           print "bad"
        else                           print "nominal" }'
}
lfs_col() { printf '38;5;117'; }

render_fairshare_one() {
    local acct=$1 f=$2 lfs=${3:-} lab pct col tcol pl ltxt llab lcol
    acct=$(sanitize "$acct")
    pl=$(fs_eval "$f"); pct=${pl%%|*}; lab=${pl##*|}
    case "$lab" in
        boosted)   col='1;38;5;48';  tcol='1;38;5;48' ;;
        ahead)     col='38;5;79';    tcol='38;5;79' ;;
        nominal)   col='38;5;75';    tcol='38;5;250' ;;
        behind)    col='38;5;214';   tcol='38;5;214' ;;
        throttled) col='1;38;5;203'; tcol='1;38;5;203' ;;
        *)         col=2;            tcol='38;5;250' ;;
    esac
    printf '  %-10s ' "$acct"
    mkbar "$pct" "$BARW_SMALL" "$col"
    printf ' %.2f  ' "$f"
    c "$tcol"; printf '%-9s' "$lab"; c '0'
    ltxt=$(lfs_txt "$lfs")
    if [ -n "$ltxt" ]; then
        llab=$(lfs_lab "$lfs"); lcol=$(lfs_col "$llab")
        c '38;5;252';    printf '  LevelFS '; c '0'
        c "$lcol"; printf '%s (%s)\n' "$ltxt" "$llab"; c '0'
    else
        printf '\n'
    fi
}

render_fairshare() {
    local data='' cached=0 fc
    fc=$(private_cache_file fairshare) || fc=''
    if [ -n "$fc" ] && cache_fresh "$fc" "$FAIRSHARE_TTL"; then
        data=$(cat "$fc" 2>/dev/null); [ -n "$data" ] && cached=1
    fi
    if [ -z "$data" ] && [ "$DBD" = 1 ]; then
        command -v sshare >/dev/null 2>&1 || return 0
        data=$(timeout "$Q_TIMEOUT" sshare -ahP --noheader -u "$TUSER" -o Account,User,Fairshare,LevelFS 2>/dev/null \
               | awk -F'|' -v u="$TUSER" '$2 ~ u && $3 != "" { sub(/^ +/,"",$1); print $1"|"$3"|"$4 }')
        if [ -n "$fc" ] && [ -n "$data" ]; then
            write_private_cache "$fc" "$data" 2>/dev/null
        fi
    fi
    [ -n "$data" ] || return 0
    if [ "$cached" = 1 ]; then
        hdr 'Fairshare' "$(c '2;33')(cached)$(c '0')"
    else
        hdr 'Fairshare'
    fi
    local rows
    rows=$(printf '%s\n' "$data" | head -n 5)
    while IFS='|' read -r acct fsv lfs; do
        [ -n "${acct:-}" ] || continue
        render_fairshare_one "$acct" "$fsv" "$lfs"
    done <<< "$rows"
    hint 'sshare'
}

render_storage() {
    local sc rows=''
    sc=$(private_cache_file storage) || sc=''
    if [ -n "$sc" ] && cache_fresh "$sc" "$STORAGE_TTL"; then
        rows=$(cat "$sc" 2>/dev/null)
    fi
    if [ -z "$rows" ]; then
        rows=$(storage_gather)
        if [ -n "$sc" ] && [ -n "$rows" ]; then
            write_private_cache "$sc" "$rows" 2>/dev/null
        fi
    fi
    [ -n "$rows" ] || return 0
    hdr 'Storage'
    local ptotal=0 nproj=0 label used size p
    while IFS='|' read -r f1 f2 f3 f4; do
        if [ "$f1" = '#' ]; then ptotal=$f2; nproj=$f3; continue; fi
        label=$f1; used=$f2; size=$f3; p=$f4
        case "$p" in *[!0-9]*|'') continue ;; esac
        label=$(sanitize "$label"); label=${label:0:12}
        if [ "$LAYOUT" = wide ]; then
            printf '  %-12s ' "$label"
            dbar "$p" "$BARW"
            printf '  %2d%%  %s / %s\n' "$p" "$used" "$size"
        else
            printf '  %-12s ' "$label"
            dbar "$p" "$BARW"
            printf ' %2d%% %s/%s\n' "$p" "$used" "$size"
        fi
    done <<< "$rows"
    if [ "$ptotal" -gt "$nproj" ]; then
        c '38;5;252'; printf '  … and %d more project dirs — diskusage_report\n' "$(( ptotal - nproj ))"; c '0'
    fi
    hint 'diskusage_report'
}

storage_gather() {
    local th="$HOME_BASE/$TUSER" p real_p seen=" "
    local -a labels=() paths=()
    [ -e "$th" ]                  && { labels+=(home);    paths+=("$th"); }
    [ -e "$SCRATCH_BASE/$TUSER" ] && { labels+=(scratch); paths+=("$SCRATCH_BASE/$TUSER"); }
    local nproj=0 ptotal=0
    for p in "$th"/projects/* "/projects/$TUSER" "/project/$TUSER"; do
        [ -d "$p" ] || continue
        real_p=$(readlink -f "$p" 2>/dev/null || echo "$p")
        case "$seen" in *" $real_p "*) continue ;; esac
        seen+="$real_p "
        ptotal=$((ptotal+1))
        if [ "$nproj" -lt "$MAX_PROJECTS" ]; then
            labels+=("$(basename "$p")"); paths+=("$real_p"); nproj=$((nproj+1))
        fi
    done
    for g in $(id -Gn "$TUSER" 2>/dev/null); do
        for base in /projects /project; do
            p="$base/$g"
            [ -d "$p" ] || continue
            real_p=$(readlink -f "$p" 2>/dev/null || echo "$p")
            case "$seen" in *" $real_p "*) continue ;; esac
            seen+="$real_p "
            ptotal=$((ptotal+1))
            if [ "$nproj" -lt "$MAX_PROJECTS" ]; then
                labels+=("$g"); paths+=("$real_p"); nproj=$((nproj+1))
            fi
        done
    done
    local out=''
    [ "${#paths[@]}" -gt 0 ] && out=$(timeout "$Q_TIMEOUT" df -h -P "${paths[@]}" 2>/dev/null)
    printf '#|%d|%d\n' "$ptotal" "$nproj"
    local i=-1 label size used pct pv
    printf '%s\n' "$out" | while read -r _fs size used _avail pct _mount _rest; do
        case "$_fs" in Filesystem|'') continue ;; esac
        i=$((i+1)); label=${labels[$i]:-?}
        pv=${pct%\%}
        case "$pv" in *[!0-9]*|'') continue ;; esac
        printf '%s|%s|%s|%s\n' "$label" "$used" "$size" "$pv"
    done
}

default_links() {
    cat <<'LINKS'
Alliance Documentation:|https://docs.alliancecan.ca
LINKS
}

render_links() {
    local src lab url
    if [ -s "$LINKS_FILE" ] && [ -r "$LINKS_FILE" ]; then
        src=$(grep -v '^[[:space:]]*\(#\|$\)' "$LINKS_FILE" 2>/dev/null)
    else
        src=$(default_links)
    fi
    [ -n "$src" ] || return 0
    hdr 'Links'
    while IFS='|' read -r lab url; do
        [ -n "${lab:-}" ] || continue
        if [ "$LAYOUT" = wide ]; then
            c '38;5;252'; printf '  %-26s' "$lab"; c '0'
            c '96';       printf '%s\n' "$url";   c '0'
        else
            c '38;5;252'; printf '  %s ' "$lab"; c '0'
            c '96';       printf '%s\n' "$url";  c '0'
        fi
    done <<< "$src"
}

# ============================================================================
if [ "${WANT_HELP:-0}" = 1 ]; then
    render_header
    render_links
    render_pod
    render_cluster;   explain_cluster
    render_jobs;      explain_jobs
    render_fairshare; explain_fairshare
    render_storage;   explain_storage
    printf '\n'
    c '0'; printf 'flags: --plain · --no-cache · --only BLOCK · --user NAME (root) · --width N\n'; c '0'
    c '0'; printf 'site config: /etc/cluster-status/motd.conf\n'; c '0'
    exit 0
fi

case "$ONLY" in
    '')        render_header; render_links; render_pod; render_cluster; render_jobs
               render_fairshare; render_storage; render_notice ;;
    header)    render_header ;;
    notice)    render_notice ;;
    pod)       render_pod ;;
    cluster)   render_cluster ;;
    jobs)      render_jobs ;;
    fairshare) render_fairshare ;;
    storage)   render_storage ;;
    links)     render_links ;;
    *) printf '%s: unknown block %s\n' "$PROG_NAME" "$ONLY" >&2; exit 2 ;;
esac
printf '\n'
c '38;5;252'; printf 'type %s to show this banner again · %s --help explains each section\n' "$PROG_NAME" "$PROG_NAME"; c '0'
exit 0

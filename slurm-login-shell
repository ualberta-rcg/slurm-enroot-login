#!/bin/bash
# Interactive-step wrapper (Slurm InteractiveStepOptions). Runs for EVERY
# interactive job cluster-wide, so it must be partition-aware:
#   - login partition: land the user in $HOME with a login shell
#     (the login-job UX)
#   - everything else: behave exactly like the old "$SHELL" default —
#     keep the submission cwd, no forced login shell
case "${SLURM_JOB_PARTITION:-}" in
    login)
        cd "${HOME:-/tmp}" 2>/dev/null || cd /tmp
        exec "${SHELL:-/bin/bash}" -l
        ;;
    *)
        exec "${SHELL:-/bin/bash}"
        ;;
esac

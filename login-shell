#!/bin/bash
# (retrigger)
# =============================================================================
# login-shell — entrypoint for the slurm-enroot-login container
# =============================================================================
# Inside a Slurm job, SLURM_*/PMI*/MPI* environment variables make srun,
# salloc and mpirun act as if they were already inside an allocation:
#   - srun would launch a step in the login job instead of a new job
#   - mpirun would cap itself at the login job's slot count
# Both are wrong for an interactive login. Scrub the job environment (keeping
# only SLURM_CONF for configless operation), then start the user's shell —
# after which clients behave exactly as on a traditional login node.
# The job's cgroup limits still apply regardless of environment.
# =============================================================================
set -u

export LOGIN_JOB_ID="${SLURM_JOB_ID:-}"

KEEP_CONF="${SLURM_CONF:-}"
for v in $(compgen -e); do
    case "$v" in
        SLURM_*|SLURMD_*|PMI_*|PMIX_*|OMPI_*|I_MPI_*|HYDRA_*) unset "$v" ;;
        # Module env inherited from the submitting host shell points at a
        # different module implementation's layout; let /etc/profile.d
        # (env-modules or the CVMFS Lmod hook) initialize it fresh instead.
        MODULEPATH|MODULERCFILE|MODULESHOME|LMOD_*|MODULES_*) unset "$v" ;;
    esac
done

# Configless config source: a mounted config wins; otherwise bootstrap
# sackd so the container fetches and caches the config from slurmctld
# itself (no dependency on the host slurmd's conf-cache).
if [[ -n $KEEP_CONF && -f $KEEP_CONF ]]; then
    export SLURM_CONF="$KEEP_CONF"      # mounted/inherited config that exists here
elif [[ -f /etc/slurm/slurm.conf ]]; then
    unset SLURM_CONF                    # mounted config; clients find /etc/slurm
else
    # inherited SLURM_CONF may point at the HOST conf-cache, which does not
    # exist in the container — bootstrap sackd instead
    export SLURM_CONF=/run/slurm/conf/slurm.conf
    mkdir -p /run/slurm/conf
    sackd -d --conf-server "${SLURM_CONF_SERVER:-slurmctld-1:6817,slurmctld-2:6817,slurmctld-3:6817}"         --conf-cache /run/slurm/conf 2>/dev/null || true
    for i in $(seq 1 10); do [[ -f $SLURM_CONF ]] && break; sleep 1; done
fi

# Small MPI smoke tests may oversubscribe the (small) login job
export OMPI_MCA_rmaps_base_oversubscribe=1

# Land the user in their home directory, not /
cd "${HOME:-/tmp}" 2>/dev/null || cd /tmp

# Docker-ENTRYPOINT semantics: bare invocation (or shell options like -c)
# gets the user's login shell; a command (from pyxis --container-entrypoint
# appending the step command) is exec'd directly.
if [[ $# -eq 0 ]]; then
    exec "${SHELL:-/bin/bash}" -l
elif [[ $1 == -* ]]; then
    exec "${SHELL:-/bin/bash}" -l "$@"
else
    exec "$@"
fi

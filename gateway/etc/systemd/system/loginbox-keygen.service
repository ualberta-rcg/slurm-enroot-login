[Unit]
Description=Generate ephemeral gateway-to-container SSH proxy keypair on first boot
DefaultDependencies=no
After=local-fs.target
Before=ssh.service loginbox-webhook.service
ConditionPathExists=!/etc/loginbox/proxy_id_ed25519

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p /etc/loginbox
ExecStart=/usr/bin/ssh-keygen -q -t ed25519 -f /etc/loginbox/proxy_id_ed25519 -N "" -C "loginbox-gateway-proxy"
ExecStart=/bin/chmod 0600 /etc/loginbox/proxy_id_ed25519
ExecStart=/bin/chmod 0644 /etc/loginbox/proxy_id_ed25519.pub

[Install]
WantedBy=multi-user.target

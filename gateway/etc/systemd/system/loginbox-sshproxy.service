[Unit]
Description=Loginbox ContainerSSH Proxy Server (Port 2222)
After=network-online.target remote-fs.target loginbox-webhook.service
Wants=network-online.target
Requires=loginbox-webhook.service
RequiresMountsFor=/cache

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/containerssh --config /etc/loginbox/containerssh.yaml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

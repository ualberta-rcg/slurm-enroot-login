# /etc/ssh/sshd_config.d/duo.conf
# Single-Port-22 authentication policy:
#   - External robot connections with a valid `restrict,from="...",command="..."`
#     key (and membership in `mfa-automation-users`) authenticate directly via
#     `publickey` (compatible with BatchMode=yes) and route to `robot-<user>`.
#   - All normal external users receive empty output from `loginbox-authorized-keys external`
#     and fall straight through to `keyboard-interactive:pam` (CILogon Device Flow).
KbdInteractiveAuthentication yes
AuthenticationMethods publickey keyboard-interactive:pam
ExposeAuthInfo yes
AllowTcpForwarding yes
AllowAgentForwarding yes
AuthorizedKeysCommand /usr/local/sbin/loginbox-authorized-keys external %u
AuthorizedKeysCommandUser root

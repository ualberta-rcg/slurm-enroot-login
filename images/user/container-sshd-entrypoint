#!/bin/bash
# =============================================================================
# container-sshd-entrypoint — persistent non-root sshd inside a Slurm login pod
# =============================================================================
# Runs inside the Pyxis/Enroot login or robot pod as the unprivileged user:
#   1. Verifies container containment (/etc/slurm-login-pods-release sentinel +
#      private mount namespace != host PID 1) — refuses to start uncontained.
#   2. Captures physical node name for Slurm job Comment routing, then applies
#      per-user UTS hostname (when unshared via --container-unshare=uts).
#   3. Creates 0700 /tmp/run-$UID (XDG_RUNTIME_DIR) and /tmp/cluster-status
#      with a jittered background cluster-status-bake loop (login pods only).
#   4. Runs non-root sshd bound strictly to RFC1918 + 127.0.0.1 with ephemeral
#      Ed25519 host key pinned in the Slurm job Comment and scrubbed SLURM_* env.
# =============================================================================
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV ENV

# 0. Containment verification: Pyxis start failures can otherwise fall through
#    to executing the task on the host OS. Refuse immediately if uncontained.
if [[ ! -f /etc/slurm-login-pods-release ]]; then
    echo "CRITICAL: /etc/slurm-login-pods-release missing — refusing to start sshd outside login pod image." >&2
    exit 1
fi
SELF_MNT_NS=$(readlink /proc/self/ns/mnt 2>/dev/null || true)
INIT_MNT_NS=$(readlink /proc/1/ns/mnt 2>/dev/null || true)
INIT_COMM=$(cat /proc/1/comm 2>/dev/null || true)
if [[ "$INIT_COMM" == "systemd" && -n "$SELF_MNT_NS" && "$SELF_MNT_NS" == "$INIT_MNT_NS" ]]; then
    echo "CRITICAL: Mount namespace matches host systemd PID 1 — refusing to run uncontained." >&2
    exit 1
fi

JOB_ID="${SLURM_JOB_ID:-}"
# Capture physical node BEFORE changing UTS hostname so Slurm Comment stays routable
NODE="${SLURMD_NODENAME:-$(/usr/bin/hostname -s)}"
UID_NUM=$(id -u)
USER_NAME=$(id -un)
SESSION_MODE="${LOGIN_GATEWAY_SESSION_MODE:-${LOGINBOX_SESSION_MODE:-login}}"
CLUSTER_NAME="${LOGIN_GATEWAY_CLUSTER_NAME:-${CC_CLUSTER:-cluster}}"
POD_HOSTNAME="${LOGIN_GATEWAY_POD_HOSTNAME:-}"
STATUS_ENABLED="${LOGIN_GATEWAY_STATUS_ENABLED:-1}"
GUARDRAILS_ENABLED="${LOGIN_GATEWAY_GUARDRAILS_ENABLED:-1}"

# Apply per-user UTS hostname ONLY when inside a distinct UTS namespace from host PID 1
if [[ -n "$POD_HOSTNAME" ]]; then
    SELF_UTS_NS=$(readlink /proc/self/ns/uts 2>/dev/null || true)
    INIT_UTS_NS=$(readlink /proc/1/ns/uts 2>/dev/null || true)
    if [[ "$INIT_COMM" != "systemd" || ( -n "$SELF_UTS_NS" && "$SELF_UTS_NS" != "$INIT_UTS_NS" ) ]]; then
        /usr/bin/hostname "$POD_HOSTNAME" 2>/dev/null || true
    fi
fi

# Resolve configless SLURM_CONF before scrubbing job environment
KEEP_CONF="${SLURM_CONF:-}"
RESOLVED_SLURM_CONF=""
if [[ -n "$KEEP_CONF" && -f "$KEEP_CONF" ]]; then
    RESOLVED_SLURM_CONF="$KEEP_CONF"
elif [[ -f /etc/slurm/slurm.conf ]]; then
    RESOLVED_SLURM_CONF=""
else
    RESOLVED_SLURM_CONF="/run/slurm/conf/slurm.conf"
    mkdir -p /run/slurm/conf 2>/dev/null || true
    sackd -d --conf-server "${SLURM_CONF_SERVER:-slurmctld-1:6817,slurmctld-2:6817,slurmctld-3:6817}" \
        --conf-cache /run/slurm/conf 2>/dev/null || true
    for _ in $(seq 1 10); do
        [[ -f "$RESOLVED_SLURM_CONF" ]] && break
        sleep 1
    done
fi

# Private 0700 XDG_RUNTIME_DIR and cluster-status cache inside job_container/tmpfs /tmp
RUNTIME_DIR="/tmp/run-${UID_NUM}"
mkdir -p "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"

STATUS_CACHE_DIR="/tmp/cluster-status"
mkdir -p "$STATUS_CACHE_DIR"
chmod 700 "$STATUS_CACHE_DIR"

SSHD_DIR="/tmp/sshd"
rm -rf "$SSHD_DIR"
mkdir -p "$SSHD_DIR"
chmod 700 "$SSHD_DIR"

# 1. Generate ephemeral Ed25519 host key in job tmpfs (<5 ms)
ssh-keygen -q -t ed25519 -f "${SSHD_DIR}/ssh_host_ed25519_key" -N "" -C "${SESSION_MODE}-${USER_NAME}@${NODE}"
chmod 600 "${SSHD_DIR}/ssh_host_ed25519_key"
chmod 644 "${SSHD_DIR}/ssh_host_ed25519_key.pub"

# 2. Install gateway proxy public key into /tmp/sshd/authorized_keys
PROXY_PUBKEY=""
for candidate_key in \
    "${LOGIN_GATEWAY_PROXY_PUBKEY:-}" \
    "${LOGINBOX_PROXY_PUBKEY:-}" \
    "/etc/login-gateway/proxy_id_ed25519.pub" \
    "/etc/loginbox/proxy_id_ed25519.pub"; do
    if [[ -n "$candidate_key" && -r "$candidate_key" ]]; then
        PROXY_PUBKEY="$candidate_key"
        break
    fi
done

if [[ -z "$PROXY_PUBKEY" ]]; then
    echo "ERROR: Gateway proxy public key not found (checked /etc/login-gateway/proxy_id_ed25519.pub)." >&2
    exit 1
fi
cp "$PROXY_PUBKEY" "${SSHD_DIR}/authorized_keys"
chmod 600 "${SSHD_DIR}/authorized_keys"

# 3. Create xauth wrapper so X11 cookies stay in /tmp/sshd/.Xauthority (zero $HOME clutter)
cat > "${SSHD_DIR}/xauth-wrapper.sh" << 'EOF'
#!/bin/bash
export XAUTHORITY=/tmp/sshd/.Xauthority
exec /usr/bin/xauth -f /tmp/sshd/.Xauthority "$@"
EOF
chmod 755 "${SSHD_DIR}/xauth-wrapper.sh"

# 4. Discover private internal IPv4 addresses (RFC1918 + 127.0.0.1; never public NICs)
declare -A SEEN_IPS=()
LISTEN_LINES=("ListenAddress 127.0.0.1")
SEEN_IPS["127.0.0.1"]=1

BIND_IPS="${LOGIN_GATEWAY_BIND_IPS:-${LOGINBOX_BIND_IPS:-}}"
if [[ -n "$BIND_IPS" ]]; then
    for ip in ${BIND_IPS//,/ }; do
        if [[ -n "$ip" && -z "${SEEN_IPS[$ip]:-}" ]]; then
            LISTEN_LINES+=("ListenAddress ${ip}")
            SEEN_IPS["$ip"]=1
        fi
    done
else
    CANDIDATE_IPS=$(
        {
            /usr/bin/hostname -I 2>/dev/null || true
            ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}' || true
        } | tr '\n' ' '
    )
    for ip in $CANDIDATE_IPS; do
        case "$ip" in
            10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*)
                if [[ -z "${SEEN_IPS[$ip]:-}" ]]; then
                    LISTEN_LINES+=("ListenAddress ${ip}")
                    SEEN_IPS["$ip"]=1
                fi
                ;;
        esac
    done
fi

port_in_use() {
    local p="$1"
    ss -ltnH "sport = :${p}" 2>/dev/null | grep -q .
}

# 5. Select collision-free port (login: 20000+ fallback 25000..29999; robot: 30000+ fallback 35000..39999)
if [[ "$SESSION_MODE" == "robot" ]]; then
    BASE_PORT=30000
    FALLBACK_START=35000
    FALLBACK_END=39999
    EFFECTIVE_STATUS="0"
    EFFECTIVE_GUARDRAILS="0"
else
    BASE_PORT=20000
    FALLBACK_START=25000
    FALLBACK_END=29999
    EFFECTIVE_STATUS="$STATUS_ENABLED"
    EFFECTIVE_GUARDRAILS="$GUARDRAILS_ENABLED"
fi

PORT=$(( BASE_PORT + UID_NUM - 50000 ))
if (( PORT < BASE_PORT || PORT > 60000 )) || port_in_use "$PORT"; then
    for candidate in $(seq "$FALLBACK_START" "$FALLBACK_END"); do
        if ! port_in_use "$candidate"; then
            PORT="$candidate"
            break
        fi
    done
fi

POD_DEFAULT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/etc/cluster-status/bin"
SETENV_LINE="PATH=${POD_DEFAULT_PATH} XAUTHORITY=/tmp/sshd/.Xauthority XDG_RUNTIME_DIR=${RUNTIME_DIR} CLUSTER_STATUS_CACHE_DIR=${STATUS_CACHE_DIR} LOGIN_JOB_ID=${JOB_ID} LOGIN_POD_NODE=${NODE} LOGIN_SESSION_MODE=${SESSION_MODE} CC_CLUSTER=${CLUSTER_NAME} LOGIN_STATUS_ENABLED=${EFFECTIVE_STATUS} LOGIN_GUARDRAILS_ENABLED=${EFFECTIVE_GUARDRAILS} OMPI_MCA_rmaps_base_oversubscribe=1"
if [[ -n "$RESOLVED_SLURM_CONF" ]]; then
    SETENV_LINE="${SETENV_LINE} SLURM_CONF=${RESOLVED_SLURM_CONF}"
fi
if [[ "$SESSION_MODE" != "robot" && -n "${LOGIN_GATEWAY_ANNOUNCE_PATH:-${CLUSTER_STATUS_ANNOUNCE:-}}" ]]; then
    SETENV_LINE="${SETENV_LINE} CLUSTER_STATUS_ANNOUNCE=${LOGIN_GATEWAY_ANNOUNCE_PATH:-${CLUSTER_STATUS_ANNOUNCE}}"
fi

# 6. Write non-root in-container sshd_config in /tmp/sshd
{
    echo "Port ${PORT}"
    for line in "${LISTEN_LINES[@]}"; do
        echo "$line"
    done
    cat << EOF
HostKey ${SSHD_DIR}/ssh_host_ed25519_key
AuthorizedKeysFile ${SSHD_DIR}/authorized_keys
PidFile ${SSHD_DIR}/sshd.pid
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
StrictModes no
PermitUserEnvironment no
ClientAliveInterval 60
ClientAliveCountMax 3
AcceptEnv LANG LC_* SSH_ORIGINAL_COMMAND
SetEnv ${SETENV_LINE}
X11Forwarding yes
X11DisplayOffset 10
X11UseLocalhost yes
XAuthLocation ${SSHD_DIR}/xauth-wrapper.sh
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
AllowAgentForwarding yes
GatewayPorts no
Subsystem sftp internal-sftp
LogLevel INFO
EOF
} > "${SSHD_DIR}/sshd_config"
chmod 600 "${SSHD_DIR}/sshd_config"

# 7. Compute host key SHA256 fingerprint + Ed25519 base64 public key for strict pinning
FP=$(ssh-keygen -lf "${SSHD_DIR}/ssh_host_ed25519_key.pub" | awk '{print $2}')
PUB_B64=$(awk '{print $2}' "${SSHD_DIR}/ssh_host_ed25519_key.pub")

# 8. Start sshd in a scrubbed environment
ENV_ARGS=(
    PATH="${POD_DEFAULT_PATH}"
    HOME="${HOME:-/home/${USER_NAME}}"
    USER="${USER_NAME}"
    LOGNAME="${USER_NAME}"
    SHELL="${SHELL:-/bin/bash}"
    LANG="${LANG:-C.UTF-8}"
    XAUTHORITY="/tmp/sshd/.Xauthority"
    XDG_RUNTIME_DIR="${RUNTIME_DIR}"
    CLUSTER_STATUS_CACHE_DIR="${STATUS_CACHE_DIR}"
    LOGIN_JOB_ID="${JOB_ID}"
    LOGIN_POD_NODE="${NODE}"
    LOGIN_SESSION_MODE="${SESSION_MODE}"
    CC_CLUSTER="${CLUSTER_NAME}"
    LOGIN_STATUS_ENABLED="${EFFECTIVE_STATUS}"
    LOGIN_GUARDRAILS_ENABLED="${EFFECTIVE_GUARDRAILS}"
)
if [[ -n "$RESOLVED_SLURM_CONF" ]]; then
    ENV_ARGS+=(SLURM_CONF="${RESOLVED_SLURM_CONF}")
fi

env -i "${ENV_ARGS[@]}" \
    /usr/sbin/sshd -D -e -f "${SSHD_DIR}/sshd_config" >"${SSHD_DIR}/sshd.log" 2>&1 &
SSHD_PID=$!

# 9. Wait until sshd is listening on PORT before publishing Comment
READY=0
for _ in $(seq 1 100); do
    if ! kill -0 "$SSHD_PID" 2>/dev/null; then
        echo "ERROR: In-container sshd exited prematurely:" >&2
        cat "${SSHD_DIR}/sshd.log" >&2 || true
        exit 1
    fi
    if port_in_use "$PORT"; then
        READY=1
        break
    fi
    sleep 0.02
done

if [[ "$READY" -ne 1 ]]; then
    echo "ERROR: Timed out waiting for in-container sshd on port ${PORT}." >&2
    cat "${SSHD_DIR}/sshd.log" >&2 || true
    kill "$SSHD_PID" 2>/dev/null || true
    exit 1
fi

# 10. Publish <node>:<port>:<fingerprint>,<pubkey_b64> to Slurm job Comment
if [[ -n "$JOB_ID" ]]; then
    scontrol update JobId="$JOB_ID" Comment="${NODE}:${PORT}:${FP},${PUB_B64}"
fi

# 11. Background cluster-status cache baker in /tmp/cluster-status (jittered 10m loop; skipped for robot pods)
BAKE_PID=""
if [[ "$SESSION_MODE" != "robot" && "$EFFECTIVE_STATUS" == "1" && -x /usr/local/sbin/cluster-status-bake ]]; then
    (
        env -i "${ENV_ARGS[@]}" CACHE_DIR="$STATUS_CACHE_DIR" /usr/local/sbin/cluster-status-bake >/dev/null 2>&1 || true
        while kill -0 "$SSHD_PID" 2>/dev/null; do
            sleep $(( 540 + (UID_NUM % 120) ))
            env -i "${ENV_ARGS[@]}" CACHE_DIR="$STATUS_CACHE_DIR" /usr/local/sbin/cluster-status-bake >/dev/null 2>&1 || true
        done
    ) &
    BAKE_PID=$!
fi

cleanup_children() {
    [[ -n "$BAKE_PID" ]] && kill "$BAKE_PID" 2>/dev/null || true
}
trap cleanup_children EXIT

# 12. Link agent skills & guardrails into $HOME (covers VS Code, ssh host cmd, OOD) + warm tmux
export TMPDIR=/tmp
if [[ "$SESSION_MODE" != "robot" ]]; then
    if [[ "$EFFECTIVE_GUARDRAILS" == "1" && -x /usr/local/bin/agent-guardrails ]]; then
        LOGIN_SESSION_MODE="$SESSION_MODE" LOGIN_GUARDRAILS_ENABLED="$EFFECTIVE_GUARDRAILS" \
            /usr/local/bin/agent-guardrails link >/dev/null 2>&1 || true
    fi
    tmux start-server \; set-option -g exit-empty off 2>/dev/null || true
fi
touch /tmp/.login_container_ready

wait "$SSHD_PID"

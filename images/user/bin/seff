#!/bin/bash
# /usr/local/bin/seff — Slurm job CPU & memory efficiency summary via sacct
set -euo pipefail

if [[ $# -ne 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: seff <JobID>" >&2
    exit 2
fi

JID="$1"
RAW=$(sacct -n -P -j "$JID" --format=JobID,User,Group,State,ExitCode,NNodes,NCPUS,ElapsedRaw,TotalCPU,ReqMem,MaxRSS 2>/dev/null || true)
if [[ -z "$RAW" ]]; then
    echo "seff: Job ${JID} not found in Slurm accounting." >&2
    exit 1
fi

python3 - "$JID" "$RAW" << 'PYEOF'
import re
import sys

target_jid = sys.argv[1]
lines = [ln for ln in sys.argv[2].splitlines() if ln.strip()]

def parse_cpu_seconds(s: str) -> float:
    if not s:
        return 0.0
    days = 0
    if "-" in s:
        d_part, s = s.split("-", 1)
        days = int(d_part)
    parts = s.split(":")
    if len(parts) == 3:
        h, m, sec = int(parts[0]), int(parts[1]), float(parts[2])
    elif len(parts) == 2:
        h, m, sec = 0, int(parts[0]), float(parts[1])
    else:
        h, m, sec = 0, 0, float(parts[0])
    return days * 86400 + h * 3600 + m * 60 + sec

def parse_mem_bytes(s: str, ncpus: int, nnodes: int) -> float:
    if not s:
        return 0.0
    m = re.match(r"^([0-9.]+)([KMGTP]?)([cn]?)$", s.strip(), re.IGNORECASE)
    if not m:
        return 0.0
    val = float(m.group(1))
    unit = m.group(2).upper()
    per = m.group(3).lower()
    mult = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4, "P": 1024**5}.get(unit, 1)
    total = val * mult
    if per == "c":
        total *= max(ncpus, 1)
    elif per == "n":
        total *= max(nnodes, 1)
    return total

def fmt_bytes(b: float) -> str:
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if b < 1024 or u == "TiB":
            return f"{b:.2f} {u}"
        b /= 1024
    return f"{b:.2f} TiB"

def fmt_hms(sec: int) -> str:
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    return f"{d}-{h:02d}:{m:02d}:{s:02d}" if d else f"{h:02d}:{m:02d}:{s:02d}"

main_row = None
max_rss_bytes = 0.0

for ln in lines:
    cols = ln.split("|")
    if len(cols) < 11:
        continue
    jid, user, group, state, exit_code, nnodes_s, ncpus_s, elapsed_s, tot_cpu, req_mem, max_rss = cols[:11]
    nnodes = int(nnodes_s or 1)
    ncpus = int(ncpus_s or 1)
    if "." not in jid and main_row is None:
        main_row = (jid, user, group, state, exit_code, nnodes, ncpus, int(elapsed_s or 0), parse_cpu_seconds(tot_cpu), req_mem)
    rss_b = parse_mem_bytes(max_rss, ncpus, nnodes)
    if rss_b > max_rss_bytes:
        max_rss_bytes = rss_b

if main_row is None:
    print(f"seff: Could not parse primary job record for {target_jid}.", file=sys.stderr)
    sys.exit(1)

jid, user, group, state, exit_code, nnodes, ncpus, elapsed, cpu_sec, req_mem_s = main_row
req_bytes = parse_mem_bytes(req_mem_s, ncpus, nnodes)
core_wall = elapsed * max(ncpus, 1)
cpu_eff = (100.0 * cpu_sec / core_wall) if core_wall > 0 else 0.0
mem_eff = (100.0 * max_rss_bytes / req_bytes) if req_bytes > 0 else 0.0

print(f"Job ID: {jid}")
print(f"User/Group: {user}/{group}")
print(f"State: {state} (exit code {exit_code.split(':')[0]})")
print(f"Nodes: {nnodes}")
print(f"Cores per node: {max(ncpus // max(nnodes, 1), 1)}")
print(f"CPU Utilized: {fmt_hms(int(cpu_sec))}")
print(f"CPU Efficiency: {cpu_eff:.2f}% of {fmt_hms(core_wall)} core-walltime")
print(f"Job Wall-clock time: {fmt_hms(elapsed)}")
print(f"Memory Utilized: {fmt_bytes(max_rss_bytes)}")
if req_bytes > 0:
    print(f"Memory Efficiency: {mem_eff:.2f}% of {fmt_bytes(req_bytes)}")
PYEOF

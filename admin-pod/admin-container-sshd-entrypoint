#!/bin/bash
# =============================================================================
# admin-container-sshd-entrypoint — root sshd inside an admin Slurm pod
# =============================================================================
# Runs as UID 0 inside a Pyxis/Enroot admin pod that was started WITHOUT a
# user namespace (Slurm job UID 0 + ENROOT_ALLOW_SUPERUSER). sshd itself stays
# root so it can open a session as the gateway admin; AllowUsers pins logins
# to that admin. From there, sudo/su work because every cluster uid/gid is
# real and /home (plus the other shared filesystems) is bind-mounted.
#
# The gateway still connects with the proxy key and reads
# "<node>:<port>:<sha256_fp>,<ed25519_pubkey_b64>" from the Slurm job Comment.
# Host keys and the authorized_keys file live in job tmpfs, not in $HOME.
# =============================================================================
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
unset BASH_ENV ENV

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: admin-container-sshd-entrypoint must run as root (uid $(id -u))." >&2
    echo "Spawn the pod with login-spawn.sh --mode admin so the Slurm job UID is 0." >&2
    exit 1
fi

# Enroot bind-mounts the image rootfs nosuid,nodev. setuid sudo/su are ignored
# until this private mount namespace is remounted suid. Failure is not fatal:
# the admin still gets a shell, and the gateway can fall back if sshd dies.
if ! mount -o remount,bind,suid / 2>/dev/null && ! mount -o remount,suid / 2>/dev/null; then
    echo "WARNING: could not remount / with suid; sudo and su may not elevate." >&2
fi

# Enroot runs hooks/mounts under umask 077 and mounts /tmp mode=755 (designed
# for 1-UID userns containers where container root == the user). In a multi-UID
# root pod with no userns, that leaves /etc/passwd + /etc/group 0600 root:root
# (breaking SlurmUser=slurm and local NSS lookups for non-root), /var/lib/sss
# 0700 root:root (blocking non-root SSSD socket traversal), and /tmp 0755.
umask 022
chmod 0644 /etc/passwd /etc/group 2>/dev/null || true
[[ -d /var/lib/sss ]] && chmod 0755 /var/lib/sss 2>/dev/null || true
chmod 1777 /tmp /var/tmp /run/lock 2>/dev/null || true

JOB_ID="${SLURM_JOB_ID:-}"
NODE="${SLURMD_NODENAME:-$(/usr/bin/hostname -s)}"
SESSION_MODE="${LOGINBOX_SESSION_MODE:-admin}"

ADMIN_USER="${LOGINBOX_ADMIN_USER:-}"
ADMIN_UID="${LOGINBOX_ADMIN_UID:-}"
ADMIN_GID="${LOGINBOX_ADMIN_GID:-}"
ADMIN_HOME="${LOGINBOX_ADMIN_HOME:-}"
ADMIN_SHELL="${LOGINBOX_ADMIN_SHELL:-/bin/bash}"

if [[ -z "$ADMIN_USER" || ! "$ADMIN_USER" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "ERROR: LOGINBOX_ADMIN_USER is missing or not a plain username." >&2
    exit 1
fi

if [[ -z "$ADMIN_UID" || -z "$ADMIN_GID" || -z "$ADMIN_HOME" ]]; then
    PW_LINE=$(getent passwd "$ADMIN_USER" 2>/dev/null || true)
    if [[ -n "$PW_LINE" ]]; then
        IFS=":" read -r _pw_name _pw_x pw_uid pw_gid _pw_gecos pw_home pw_shell <<< "$PW_LINE"
        [[ -z "$ADMIN_UID" ]] && ADMIN_UID="$pw_uid"
        [[ -z "$ADMIN_GID" ]] && ADMIN_GID="$pw_gid"
        [[ -z "$ADMIN_HOME" ]] && ADMIN_HOME="$pw_home"
        [[ -n "${pw_shell:-}" ]] && ADMIN_SHELL="$pw_shell"
    fi
fi

if [[ -z "$ADMIN_UID" || -z "$ADMIN_GID" ]]; then
    echo "ERROR: could not resolve uid/gid for admin user ${ADMIN_USER}." >&2
    exit 1
fi
[[ -z "$ADMIN_HOME" ]] && ADMIN_HOME="/home/${ADMIN_USER}"

# Trigger autofs on the admin home once /home is bind-mounted.
ls -d "${ADMIN_HOME}/." >/dev/null 2>&1 || true

# Per-user sudoers so elevation works even if the %gateway-admins NSS lookup
# is briefly unavailable. The name was validated above; visudo still checks it.
if [[ -d /etc/sudoers.d ]]; then
    SUDOERS_TMP=$(mktemp /etc/sudoers.d/.loginbox-admin.XXXXXX 2>/dev/null || true)
    if [[ -n "${SUDOERS_TMP:-}" ]]; then
        printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$ADMIN_USER" > "$SUDOERS_TMP"
        chown root:root "$SUDOERS_TMP"
        chmod 0440 "$SUDOERS_TMP"
        if visudo -cf "$SUDOERS_TMP" >/dev/null 2>&1; then
            mv -f "$SUDOERS_TMP" /etc/sudoers.d/loginbox-admin-user
        else
            rm -f "$SUDOERS_TMP"
            echo "WARNING: refused to install per-user sudoers drop-in for ${ADMIN_USER}." >&2
        fi
    else
        echo "WARNING: /etc/sudoers.d is not writable; group sudoers will be used." >&2
    fi
fi

KEEP_CONF="${SLURM_CONF:-}"
RESOLVED_SLURM_CONF=""
if [[ -n "$KEEP_CONF" && -f "$KEEP_CONF" ]]; then
    RESOLVED_SLURM_CONF="$KEEP_CONF"
elif [[ -f /etc/slurm/slurm.conf ]]; then
    RESOLVED_SLURM_CONF=""
else
    RESOLVED_SLURM_CONF="/run/slurm/conf/slurm.conf"
    mkdir -p /run/slurm/conf 2>/dev/null || true
    sackd -d --conf-server "${SLURM_CONF_SERVER:-slurmctld-1:6817,slurmctld-2:6817,slurmctld-3:6817}" \
        --conf-cache /run/slurm/conf 2>/dev/null || true
    for _ in $(seq 1 10); do
        [[ -f "$RESOLVED_SLURM_CONF" ]] && break
        sleep 1
    done
fi

# Privilege separation needs a root-owned runtime dir. /run is the job tmpfs,
# not the directory baked into the image.
mkdir -p /run/sshd
chmod 755 /run/sshd

SSHD_DIR="/tmp/sshd"
rm -rf "$SSHD_DIR"
mkdir -p "$SSHD_DIR"
chmod 755 "$SSHD_DIR"

ssh-keygen -q -t ed25519 -f "${SSHD_DIR}/ssh_host_ed25519_key" -N "" -C "admin-${ADMIN_USER}@${NODE}"
chmod 600 "${SSHD_DIR}/ssh_host_ed25519_key"
chmod 644 "${SSHD_DIR}/ssh_host_ed25519_key.pub"

PROXY_PUBKEY=""
for candidate_key in \
    "${LOGINBOX_PROXY_PUBKEY:-}" \
    "/etc/loginbox/proxy_id_ed25519.pub" \
    "/loginbox-poc/proxy_id_ed25519.pub"; do
    if [[ -n "$candidate_key" && -r "$candidate_key" ]]; then
        PROXY_PUBKEY="$candidate_key"
        break
    fi
done

if [[ -z "$PROXY_PUBKEY" ]]; then
    echo "ERROR: Gateway proxy public key not found (checked /etc/loginbox/proxy_id_ed25519.pub)." >&2
    exit 1
fi
cp "$PROXY_PUBKEY" "${SSHD_DIR}/authorized_keys"
chown root:root "${SSHD_DIR}/authorized_keys"
# sshd's privilege-separated child, not root, reads this file. It holds only
# the gateway proxy public key, so it must be world-readable.
chmod 644 "${SSHD_DIR}/authorized_keys"

# X11 cookies + xauth lock files (.Xauthority-c) must live in a directory
# writable by the admin session, while /tmp/sshd itself stays root-owned.
XAUTH_DIR="${SSHD_DIR}/xauth"
XAUTH_FILE="${XAUTH_DIR}/.Xauthority"
mkdir -p "$XAUTH_DIR"
touch "$XAUTH_FILE"
chown -R "${ADMIN_UID}:${ADMIN_GID}" "$XAUTH_DIR"
chmod 700 "$XAUTH_DIR"
chmod 600 "$XAUTH_FILE"

cat > "${SSHD_DIR}/xauth-wrapper.sh" << 'EOF'
#!/bin/bash
export XAUTHORITY=/tmp/sshd/xauth/.Xauthority
exec /usr/bin/xauth -f /tmp/sshd/xauth/.Xauthority "$@"
EOF
chmod 755 "${SSHD_DIR}/xauth-wrapper.sh"

declare -A SEEN_IPS=()
LISTEN_LINES=("ListenAddress 127.0.0.1")
SEEN_IPS["127.0.0.1"]=1

if [[ -n "${LOGINBOX_BIND_IPS:-}" ]]; then
    for ip in ${LOGINBOX_BIND_IPS//,/ }; do
        if [[ -n "$ip" && -z "${SEEN_IPS[$ip]:-}" ]]; then
            LISTEN_LINES+=("ListenAddress ${ip}")
            SEEN_IPS["$ip"]=1
        fi
    done
else
    CANDIDATE_IPS=$(
        {
            /usr/bin/hostname -I 2>/dev/null || true
            ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}' || true
        } | tr '\n' ' '
    )
    for ip in $CANDIDATE_IPS; do
        case "$ip" in
            10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*)
                if [[ -z "${SEEN_IPS[$ip]:-}" ]]; then
                    LISTEN_LINES+=("ListenAddress ${ip}")
                    SEEN_IPS["$ip"]=1
                fi
                ;;
        esac
    done
fi

port_in_use() {
    local p="$1"
    ss -ltnH "sport = :${p}" 2>/dev/null | grep -q .
}

# login: 20000+, robot: 30000+, admin: 40000+ so a root-owned pod never
# collides with that admin's unprivileged login pod (which keys off the same uid).
BASE_PORT=40000
FALLBACK_START=45000
FALLBACK_END=49999

PORT=$(( BASE_PORT + ADMIN_UID - 50000 ))
if (( PORT < BASE_PORT || PORT > 60000 )) || port_in_use "$PORT"; then
    PORT=""
    for candidate in $(seq "$FALLBACK_START" "$FALLBACK_END"); do
        if ! port_in_use "$candidate"; then
            PORT="$candidate"
            break
        fi
    done
fi

if [[ -z "$PORT" ]]; then
    echo "ERROR: no free admin sshd port in ${FALLBACK_START}-${FALLBACK_END}." >&2
    exit 1
fi

SETENV_LINE="XAUTHORITY=${XAUTH_FILE} LOGIN_JOB_ID=${JOB_ID} OMPI_MCA_rmaps_base_oversubscribe=1"
if [[ -n "$RESOLVED_SLURM_CONF" ]]; then
    SETENV_LINE="${SETENV_LINE} SLURM_CONF=${RESOLVED_SLURM_CONF}"
fi

{
    echo "Port ${PORT}"
    for line in "${LISTEN_LINES[@]}"; do
        echo "$line"
    done
    cat << EOF
HostKey ${SSHD_DIR}/ssh_host_ed25519_key
AuthorizedKeysFile ${SSHD_DIR}/authorized_keys
PidFile ${SSHD_DIR}/sshd.pid
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers ${ADMIN_USER}
StrictModes no
PermitUserEnvironment no
AcceptEnv LANG LC_* SSH_ORIGINAL_COMMAND
SetEnv ${SETENV_LINE}
X11Forwarding yes
X11DisplayOffset 10
X11UseLocalhost yes
XAuthLocation ${SSHD_DIR}/xauth-wrapper.sh
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
AllowAgentForwarding yes
GatewayPorts clientspecified
Subsystem sftp internal-sftp
LogLevel INFO
EOF
} > "${SSHD_DIR}/sshd_config"
chmod 600 "${SSHD_DIR}/sshd_config"

FP=$(ssh-keygen -lf "${SSHD_DIR}/ssh_host_ed25519_key.pub" | awk '{print $2}')
PUB_B64=$(awk '{print $2}' "${SSHD_DIR}/ssh_host_ed25519_key.pub")

# sshd runs as root. Sessions for AllowUsers drop to the admin uid, so the
# scrubbed environment must not pin USER/HOME to root.
ENV_ARGS=(
    PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    HOME="${ADMIN_HOME}"
    USER="${ADMIN_USER}"
    LOGNAME="${ADMIN_USER}"
    SHELL="${ADMIN_SHELL}"
    LANG="${LANG:-C.UTF-8}"
    XAUTHORITY="${XAUTH_FILE}"
    LOGIN_JOB_ID="${JOB_ID}"
)
if [[ -n "$RESOLVED_SLURM_CONF" ]]; then
    ENV_ARGS+=(SLURM_CONF="${RESOLVED_SLURM_CONF}")
fi

env -i "${ENV_ARGS[@]}" \
    /usr/sbin/sshd -D -e -f "${SSHD_DIR}/sshd_config" >"${SSHD_DIR}/sshd.log" 2>&1 &
SSHD_PID=$!

READY=0
for _ in $(seq 1 100); do
    if ! kill -0 "$SSHD_PID" 2>/dev/null; then
        echo "ERROR: In-container sshd exited prematurely:" >&2
        cat "${SSHD_DIR}/sshd.log" >&2 || true
        exit 1
    fi
    if port_in_use "$PORT"; then
        READY=1
        break
    fi
    sleep 0.02
done

if [[ "$READY" -ne 1 ]]; then
    echo "ERROR: Timed out waiting for in-container sshd on port ${PORT}." >&2
    cat "${SSHD_DIR}/sshd.log" >&2 || true
    kill "$SSHD_PID" 2>/dev/null || true
    exit 1
fi

if [[ -n "$JOB_ID" ]]; then
    scontrol update JobId="$JOB_ID" Comment="${NODE}:${PORT}:${FP},${PUB_B64}"
fi

export TMPDIR=/tmp
if [[ "$SESSION_MODE" != "robot" ]]; then
    setpriv --reuid="$ADMIN_UID" --regid="$ADMIN_GID" --init-groups \
        env HOME="$ADMIN_HOME" USER="$ADMIN_USER" LOGNAME="$ADMIN_USER" TMPDIR=/tmp \
        tmux start-server \; set-option -g exit-empty off 2>/dev/null || true
fi
touch /tmp/.login_container_ready

wait "$SSHD_PID"

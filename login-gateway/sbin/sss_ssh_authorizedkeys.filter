#!/bin/bash
# /usr/local/sbin/sss_ssh_authorizedkeys.filter
# Alliance-standard MFA Automation ("robot") SSH key wrapper:
#   - Verifies membership in ROBOT_GROUP (`mfa-automation-users`) via SSSD.
#   - Fetches public keys exclusively from CCDB/LDAP (`sss_ssh_authorizedkeys`)
#     by default (`ALLOW_HOME_ROBOT_KEYS=0` per Alliance policy).
#   - Pipes candidate keys through `sss_ssh_authorizedkeys.filter.py` so ONLY
#     keys with `restrict`, narrow public `from="..."`, and `command="..."` pass.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for candidate_conf in \
    "${LOGIN_GATEWAY_CONF:-}" \
    "/etc/login-gateway/login-gateway.conf" \
    "/etc/loginbox/loginbox.conf"; do
    if [[ -n "$candidate_conf" && -r "$candidate_conf" ]]; then
        # shellcheck disable=SC1090
        source "$candidate_conf"
        break
    fi
done

ROBOT_ENABLED="${ROBOT_ENABLED:-1}"
ROBOT_GROUP="${ROBOT_GROUP:-mfa-automation-users}"
ALLOW_HOME_ROBOT_KEYS="${ALLOW_HOME_ROBOT_KEYS:-0}"
MIN_CLUSTER_UID="${MIN_CLUSTER_UID:-10000}"
SHIM_USERS="${SHIM_USERS:-}"

[[ "$ROBOT_ENABLED" == "1" ]] || exit 0

FILTER_ARGS=()
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --rewrite-dispatch|--inject-robot-marker|--allow-wildcard-from|--allow-private-from|--allow-hostname-from)
            FILTER_ARGS+=("$1")
            shift
            ;;
        --dispatch-bin)
            FILTER_ARGS+=("$1" "${2:-}")
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

TARGET_USER="${1:-}"

in_word_list() {
    local needle="$1" list="$2" item
    [[ -z "$needle" || -z "$list" ]] && return 1
    for item in $list; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

# If a site NSS shim rewrote %u inside ssh.service, recover the requested user
# from the privileged sshd monitor proctitle ('sshd: <user> [priv]').
if in_word_list "$TARGET_USER" "$SHIM_USERS" && [[ -r "/proc/${PPID}/cmdline" ]]; then
    PPID_CMD=$(tr '\0' ' ' < "/proc/${PPID}/cmdline" 2>/dev/null || true)
    if [[ "$PPID_CMD" =~ ^sshd:[[:space:]]+([a-zA-Z0-9._-]+)[[:space:]]+\[priv\] ]]; then
        TARGET_USER="${BASH_REMATCH[1]}"
    fi
fi

if [[ -z "$TARGET_USER" || ! "$TARGET_USER" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    exit 0
fi

case "$TARGET_USER" in
    root|sshd|munge|slurm|nobody|ubuntu|www-data)
        exit 0
        ;;
esac
if in_word_list "$TARGET_USER" "$SHIM_USERS"; then
    exit 0
fi

PW_LINE=$(getent -s sss passwd "$TARGET_USER" 2>/dev/null || getent -s files passwd "$TARGET_USER" 2>/dev/null || true)
if [[ -z "$PW_LINE" ]]; then
    exit 0
fi

IFS=":" read -r _pw_name _pw_x USER_UID USER_GID _pw_gecos USER_HOME _pw_shell <<< "$PW_LINE"
if [[ -z "${USER_UID:-}" ]] || (( USER_UID < MIN_CLUSTER_UID )); then
    exit 0
fi

# Verify membership in ROBOT_GROUP via SSSD/group database before reading keys
IS_MEMBER=0
GRP_LINE=$(getent -s sss group "$ROBOT_GROUP" 2>/dev/null || getent -s files group "$ROBOT_GROUP" 2>/dev/null || true)
if [[ -n "$GRP_LINE" ]]; then
    IFS=":" read -r _g_name _g_pw GRP_GID GRP_MEMBERS <<< "$GRP_LINE"
    if [[ "${USER_GID:-}" == "${GRP_GID:-}" ]]; then
        IS_MEMBER=1
    else
        IFS="," read -ra M_ARR <<< "${GRP_MEMBERS:-}"
        for m in "${M_ARR[@]}"; do
            if [[ "$m" == "$TARGET_USER" ]]; then
                IS_MEMBER=1
                break
            fi
        done
    fi
fi
if [[ "$IS_MEMBER" -ne 1 ]]; then
    if [[ " $(id -Gn "$TARGET_USER" 2>/dev/null || true) " == *" ${ROBOT_GROUP} "* ]]; then
        IS_MEMBER=1
    fi
fi
if [[ "$IS_MEMBER" -ne 1 ]]; then
    exit 0
fi

read_safe_home_keys() {
    python3 - "$USER_HOME" "$USER_UID" << 'PYEOF'
import os, stat, sys

homedir = sys.argv[1]
expected_uid = int(sys.argv[2])

def check_dir(path, allow_root=False):
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode):
        return False
    if st.st_uid != expected_uid and not (allow_root and st.st_uid == 0):
        return False
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        return False
    return True

try:
    if not check_dir(homedir, allow_root=True):
        sys.exit(0)
    ssh_dir = os.path.join(homedir, ".ssh")
    if not check_dir(ssh_dir, allow_root=False):
        sys.exit(0)
    ak_path = os.path.join(ssh_dir, "authorized_keys")
    st_ak = os.lstat(ak_path)
    if not stat.S_ISREG(st_ak.st_mode):
        sys.exit(0)
    if st_ak.st_uid != expected_uid:
        sys.exit(0)
    if st_ak.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        sys.exit(0)
    fd = os.open(ak_path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as fh:
        sys.stdout.write(fh.read())
except OSError:
    sys.exit(0)
PYEOF
}

FILTER_PY="${SCRIPT_DIR}/sss_ssh_authorizedkeys.filter.py"
[[ ! -f "$FILTER_PY" ]] && FILTER_PY="/usr/local/sbin/sss_ssh_authorizedkeys.filter.py"

{
    if [[ -x /usr/bin/sss_ssh_authorizedkeys ]]; then
        /usr/bin/sss_ssh_authorizedkeys "$TARGET_USER" 2>/dev/null || true
    fi
    if [[ "$ALLOW_HOME_ROBOT_KEYS" == "1" && -n "$USER_HOME" ]]; then
        read_safe_home_keys
    fi
} | python3 "$FILTER_PY" "${FILTER_ARGS[@]}"
exit 0
